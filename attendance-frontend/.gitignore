# Dependencias
node_modules/

# Build
dist/

# Variables de entorno (NUNCA subir al repo)
.env
.env.local
.env.*.local
.env.mobile
*.local

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Capacitor — las plataformas nativas SÍ se versionan (recomendación oficial):
# contienen configuración que no se puede regenerar (Firebase en AppDelegate,
# deployment target, bundle identifier, capabilities). Sólo se excluye lo que
# es generado o sensible.

# Android — dependencias y salidas de compilación
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/google-services.json

# iOS — dependencias, salidas de compilación y preferencias personales
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/DerivedData/
ios/App/*.xcodeproj/xcuserdata/
ios/App/*.xcworkspace/xcuserdata/

# iOS — credenciales (nunca al repo; hay copia en credentials/)
ios/App/App/GoogleService-Info.plist
