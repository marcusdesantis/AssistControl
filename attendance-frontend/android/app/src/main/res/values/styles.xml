<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- windowOptOutEdgeToEdgeEnforcement se eliminó a propósito: Android 16
             (API 36) ignora ese opt-out, así que ya no evitaba nada y Play Console
             lo señalaba. El contenido se compensa vía env(safe-area-inset-*) en
             src/index.css, activado con la clase body.platform-android. -->
        <!-- Iconos oscuros sobre fondo claro; sin color de barra (obsoleto en API 35+) -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- La WebView queda dentro del área segura (padding aplicado en MainActivity),
             así que las franjas de las barras muestran este fondo. -->
        <item name="android:windowBackground">@color/systemBarBackground</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/colorPrimary</item>
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>